{
  "manifest_version": 3,
  "name": "Daytrail",
  "version": "1.5.0",
  "description": "See your Google searches and browsing trends from this Chrome profile.",
  "minimum_chrome_version": "120",
  "key": "",
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Daytrail",
    "default_popup": "popup.html"
  },
  "permissions": [
    "identity",
    "identity.email",
    "storage",
    "favicon"
  ],
  "optional_permissions": [
    "history",
    "tabs",
    "idle",
    "alarms"
  ],
  "host_permissions": [
    "https://openidconnect.googleapis.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src https://openidconnect.googleapis.com; frame-ancestors 'none'; base-uri 'none'"
  },
  "oauth2": {
    "client_id": "499681575157-nddndnisoopn0up8rlv36h02j3sg3api.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  }
}
