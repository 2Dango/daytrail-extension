{
  "manifest_version": 3,
  "name": "Daytrail",
  "version": "2.1.0",
  "description": "Explore your browsing trails, save your next step, and protect your focus \u2014 all on this device.",
  "minimum_chrome_version": "120",
  "key": "",
  "incognito": "not_allowed",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Open Daytrail",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "favicon",
    "activeTab"
  ],
  "optional_permissions": [
    "history",
    "tabs",
    "idle",
    "alarms",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'none'; frame-ancestors 'none'; base-uri 'none'"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "blocked.css",
        "styles.css",
        "PixelifySans.ttf",
        "icon-32.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
